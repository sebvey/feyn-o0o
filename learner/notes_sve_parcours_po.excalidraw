      "seed": 621882707,
      "version": 315,
      "versionNonce": 1666989395,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792576413559,
      "link": null,
      "locked": false,
      "text": "Exemple découpage feature / stories :\n\nFEATURE = Comparer la marge entre usine\nSTORIES :\n- voir la marge du mois par usine\n- être alerté quand la marge baisse de plus de 5%",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Exemple découpage feature / stories :\n\nFEATURE = Comparer la marge entre usine\nSTORIES :\n- voir la marge du mois par usine\n- être alerté quand la marge baisse de plus de 5%",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "H4WgVP_8GLJIuE0vJ30ol",
      "type": "text",
      "x": -3967.6952611476686,
      "y": 1819.7690247945743,
      "width": 512.379638671875,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
